{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(tar:*)",
      "Bash(curl:*)",
      "Bash(source:*)",
      "Bash(pkill:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip show:*)",
      "Bash(pip install:*)",
      "Bash(uv run python:*)",
      "Bash(uv run pytest:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker exec:*)",
      "Bash(docker inspect:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose ps:*)",
      "Bash(xargs -I {} sh -c 'echo \"=== {} ===\" && head -50 {}')",
      "Bash(xargs -I {} sh -c 'echo \"=== {} ===\" && head -80 {}')",
      "Bash(dev-browser:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "skillOverrides": {
    "find-skills": "off",
    "python-type-hints": "off"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf \"\\x1b]9;Claude: $MESSAGE\\x07\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/ruff-post-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/ai/hooks/agent-roster.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/ai/hooks/agent-roster.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] || bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" ] || PATH=/opt/homebrew/bin:\"$PATH\" python3 \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/ai/hooks/agent-roster.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/ai/hooks/agent-roster.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/ai/hooks/agent-roster.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/ai/hooks/task-completed-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" ] || PATH=/opt/homebrew/bin:\"$PATH\" python3 \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" --hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e \"$HOME/workspace/ai/scripts/resource_guard/audit_guard.py\" ] || PATH=/opt/homebrew/bin:\"$PATH\" gtimeout --kill-after=3 25 python3 \"$HOME/workspace/ai/scripts/resource_guard/audit_guard.py\" --apply --budget-seconds 20 >/dev/null",
            "timeout": 30
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" ] || PATH=/opt/homebrew/bin:\"$PATH\" python3 \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" ] || PATH=/opt/homebrew/bin:\"$PATH\" python3 \"$HOME/workspace/ai/scripts/resource_guard/claude_guard.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "cli-tools@netresearch-claude-code-marketplace": true,
    "code-simplifier@claude-plugins-official": false,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "i-have-adhd@i-have-adhd": true,
    "playground@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "netresearch-claude-code-marketplace": {
      "source": {
        "source": "github",
        "repo": "netresearch/claude-code-marketplace"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "brag": {
      "source": {
        "source": "github",
        "repo": "latent-spaces/brag"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 750000,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "precomputeCompactionEnabled": true,
  "idleCompaction": false,
  "switchModelsOnFlag": false,
  "showTurnDuration": true,
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: not queryable via gh here (no remote configured for this repo — ~ has no tracked files and no remotes); assume private by default per shipped default",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: not queryable via gh (no remote configured); default branch unknown (origin/HEAD unset)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured — the 'Bucket names in config' list (bucket, bucket_name, my-bucket, mybucket, etc.) consists of generic placeholder-style names from scattered example/doc files, not org-identifying names, and is not corroborated by any usage-section bucket mention; not adopted",
      "**Key internal services**: None configured",
      "**Internal package registry**: pypi.gocept.com (config-derived — not a confirmed upload destination; uploads of local data still require confirmation)",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — note .claude-mem/.env, .claude-o-gram/hook-secret, .codex/hooks/block-secrets.sh, .config/context7/credentials.json, .config/herdr-remote/secrets.env appear under the home directory as sensitive-looking paths",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: ~ — no git remotes configured and no tracked files; this is the Claude Code starting directory but is not itself a populated git project",
      "**Org-specific CLIs**: None configured — routine non-standard CLIs observed: rtk, strings, uv, herdr, pmset, readlink, rmdir, setopt, test"
    ]
  }
}
